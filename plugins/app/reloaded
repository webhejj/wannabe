#!/usr/bin/env bun
// wannabe: --to <context> [--dry-run] — restart the app wannabe started, so it runs the current code
//
// With spec.reloadCommand: runs it, and waits for the app to restart in place, its readiness URL going down
// and answering again. A failing command (a compile error) leaves the app running what it ran before; no
// restart within 10s is a failure too.
//
// Without it: app stopped, then app running; the command builds what changed as it starts.
//
// Starts the app when nothing runs; exit 3 when something wannabe did not start is on the port.
import { app, ownedPid, refuseForeign, reloadInPlace, startAndWait, stop } from "../../lib/app.ts";
import { die, parseArgs, say } from "../../lib/plugin.ts";

const args = parseArgs();
const a = await app(args.context);
const pid = ownedPid(a);
if (!pid) refuseForeign(a);
if (args.dryRun) {
  if (pid && a.reloadCommand) say(`dry run: ${a.reloadCommand.join(" ")}, then wait for ${a.readiness} to go down and answer again`);
  else {
    if (pid) say(`dry run: stop pid ${pid} and what listens on :${a.port}`);
    say(`dry run: ${a.command.join(" ")} (log: ${a.logFile}), then wait up to ${a.startTimeoutSeconds}s for ${a.readiness}`);
  }
  process.exit(0);
}
if (pid && a.reloadCommand) {
  await reloadInPlace(a, pid, a.reloadCommand);
  process.exit(0);
}
if (pid) {
  say(`Stopping pid ${pid}`);
  if (!(await stop(a, pid))) die(1, `something still listens on :${a.port}`);
}
await startAndWait(a);
