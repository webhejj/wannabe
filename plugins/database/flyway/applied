#!/usr/bin/env bun
// wannabe: --to <context> [--dry-run] — apply the pending migrations to the context's database
//
// Runs flyway migrate through spec.flyway in .wannabe/<context>/database.yaml, the project's own way of
// running Flyway against that database. The context must allow "flyway applied" in database.yaml.
import { flyway, requireAllowed, tool } from "../../../lib/database.ts";
import { parseArgs, say } from "../../../lib/plugin.ts";

const args = parseArgs();
await requireAllowed(args.context);
if (args.dryRun) {
  say(`dry run: ${(await tool(args.context, "flyway")).join(" ")} migrate`);
  process.exit(0);
}

await flyway(args.context, "migrate", "stderr");
